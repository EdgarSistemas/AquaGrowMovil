<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DisenioAPP" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="MyButtonStyle" parent="Widget.MaterialComponents.Button">
        <!-- Color de la barra de estado -->
        <item name="android:statusBarColor">@color/teal_700</item>

        <!-- Color de los íconos (true = claros, false = oscuros) -->
        <item name="android:windowLightStatusBar">true</item>

        <item name="backgroundTint">@color/azul_claro</item> <!-- Color de fondo -->
        <item name="cornerRadius">12dp</item> <!-- Bordes redondeados -->
    </style>
</resources>