<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión de Cultivo"
            android:textSize="24sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <!-- Nombre de la planta -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la planta">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombrePlanta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Días esperados -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Días esperados">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDiasEsperados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Rendimiento esperado -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Rendimiento esperado">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRendimientoEsperado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón Guardar -->
        <Button
            android:id="@+id/btnGuardarCultivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar cultivo"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/color_boton"
            android:textColor="@color/white" />

        <!-- Botón Terminar cultivo -->
        <Button
            android:id="@+id/btnTerminarCultivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Terminar cultivo"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:backgroundTint="@color/color_boton"
            android:textColor="@color/white" />

        <!-- Carga -->
        <ProgressBar
            android:id="@+id/progressBarGrowing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
